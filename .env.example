# Inventaire des variables lues par app/core/config.py (Settings).
# Les valeurs ci-dessous sont des exemples. Ne pas y mettre de secrets réels.

APP_ENV=development
LOG_LEVEL=INFO

# Base de données PostgreSQL (asyncpg)
DATABASE_URL=postgresql+asyncpg://radar_user:radar_password@postgres:5432/radar_db

# Cache Redis
REDIS_URL=redis://redis:6379/0

# Bot Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_string
# TELEGRAM_WEBHOOK_URL n'est pas lu par l'application.
# L'URL du webhook se déclare auprès de Telegram et doit se terminer par
# /api/v1/telegram/webhook/<TELEGRAM_WEBHOOK_SECRET>.

# Endpoints API
INGEST_API_TOKEN=your_secure_ingest_token
INTERNAL_API_TOKEN=your_secure_internal_token

# eBay Browse (optionnel). EBAY_ENV vaut PRODUCTION ou SANDBOX.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=PRODUCTION

# Planification du rafraîchissement des prix (Europe/Paris)
PRICE_REFRESH_TIMES=07:00,19:00

# Chasse-aux-livres (Optionnel : jeton utilisateur pour l'historique 1 an /rest/jcd)
CHASSE_AUX_LIVRES_DUIH=

# Poller Vinted, dans le même processus que l'API.
# Le scheduler (prix et nettoyage) démarre même si le poller est désactivé.
RADAR_API_URL=http://127.0.0.1:8000
VINTED_POLL_INTERVAL_SECONDS=15
VINTED_POLLER_ENABLED=true
VINTED_PROXY_URL=

# Mode nuit (Europe/Paris)
NIGHT_MODE_ENABLED=true
NIGHT_MODE_START_HOUR=0
NIGHT_MODE_END_HOUR=7
NIGHT_MODE_TIMEZONE=Europe/Paris

# Moteur IA (DeepSeek)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash
AI_ENABLED=true
AI_FEATURE_NATURAL_ADD=true
AI_FEATURE_PROFIT_SCORING=true
AI_FEATURE_NEGOTIATION=true
AI_FEATURE_KEYWORD_VARIANTS=true
AI_FEATURE_AUTO_TUNING=true

# Réservées à Docker Compose, ignorées par Settings :
# POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB, DOMAIN_NAME
