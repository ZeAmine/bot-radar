# Variables applicatives (Settings) et Docker Compose ; valeurs d'exemple, jamais de secrets réels.

APP_ENV=development
LOG_LEVEL=INFO

# Base de données PostgreSQL (asyncpg)
DATABASE_URL=postgresql+asyncpg://radar_user:replace_with_a_unique_postgres_password@postgres:5432/radar_db

REDIS_URL=redis://redis:6379/0

# Bot Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_string
# TELEGRAM_WEBHOOK_URL non lu par l'app ; URL déclarée auprès de Telegram, suffixe /api/v1/telegram/webhook/<secret>.

INGEST_API_TOKEN=your_secure_ingest_token
INTERNAL_API_TOKEN=your_secure_internal_token

# eBay Browse (optionnel). EBAY_ENV vaut PRODUCTION ou SANDBOX.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=PRODUCTION

# Planification du rafraîchissement des prix (Europe/Paris)
PRICE_REFRESH_TIMES=07:00,19:00

# Chasse-aux-livres (Optionnel : jeton utilisateur pour l'historique 1 an /rest/jcd)
CHASSE_AUX_LIVRES_DUIH=

# Google Books (optionnel) : 3e source si BNF et OpenLibrary se taisent (vide=absent) ; clé console.cloud.google.com, 1000/j.
GOOGLE_BOOKS_API_KEY=

# Poller Vinted dans le même processus que l'API ; le scheduler (prix/nettoyage) démarre même si poller désactivé.
BOTRADAR_API_URL=http://127.0.0.1:8000
RADAR_API_URL=http://127.0.0.1:8000
VINTED_POLL_INTERVAL_SECONDS=12
VINTED_POLLER_ENABLED=true
# Le proxy n'est utilisé que si VINTED_PROXY_ENABLED est vrai : une URL seule
# n'active ni les clients ni la cadence accélérée.
VINTED_PROXY_ENABLED=false
VINTED_PROXY_URL=

# Mode nuit (Europe/Paris)
NIGHT_MODE_ENABLED=true
NIGHT_MODE_START_HOUR=0
NIGHT_MODE_END_HOUR=7
NIGHT_MODE_TIMEZONE=Europe/Paris

# Moteur IA : AI_PROVIDER = openai-compatible (DeepSeek, Groq, Mistral, OpenRouter, Ollama, LM Studio…) ou anthropic ; voir app/providers/llm/registry.py.
AI_PROVIDER=openai-compatible
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-flash
AI_TIMEOUT_SECONDS=12.0
AI_ENABLED=true
AI_FEATURE_NATURAL_ADD=true
AI_FEATURE_PROFIT_SCORING=true
AI_FEATURE_NEGOTIATION=true
AI_FEATURE_KEYWORD_VARIANTS=true
AI_FEATURE_AUTO_TUNING=true

# Réservées à Docker Compose (ignorées par Settings), obligatoires non vides ; cohérentes avec DATABASE_URL.
POSTGRES_USER=radar_user
POSTGRES_PASSWORD=replace_with_a_unique_postgres_password
POSTGRES_DB=radar_db
# DOMAIN_NAME n’est consommé ni par Settings ni par ce Compose.
